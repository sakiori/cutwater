{
  "name": "cutwater",
  "version": "0.2.0",
  "description": "Releases the packages of a repository through one bot-maintained merge request, from reviewed changeset files",
  "keywords": [
    "release",
    "changeset",
    "monorepo",
    "gitlab",
    "versioning"
  ],
  "homepage": "https://gitlab.com/sakiori-oss/cutwater",
  "bugs": "https://gitlab.com/sakiori-oss/cutwater/-/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/sakiori-oss/cutwater.git",
    "directory": "npm/cutwater"
  },
  "bin": {
    "cutwater": "bin/cutwater.js"
  },
  "files": [
    "bin/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepack": "node ../check-package.mjs"
  },
  "optionalDependencies": {
    "@sakiori/cutwater-bin-darwin-arm64": "0.2.0",
    "@sakiori/cutwater-bin-darwin-x64": "0.2.0",
    "@sakiori/cutwater-bin-linux-arm64": "0.2.0",
    "@sakiori/cutwater-bin-linux-x64": "0.2.0"
  }
}
